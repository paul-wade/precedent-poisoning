{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NQiehXyJ8npfp2SipC6QdU","type":"tool_result","content":"1\t/**\n2\t * Error taxonomy and status map.\n3\t *\n4\t * Errors carry a code and a message. The status map keeps the HTTP status\n5\t * that belongs to each code in one place.\n6\t */\n7\t\n8\texport interface AppError {\n9\t  readonly code: string;\n10\t  readonly message: string;\n11\t}\n12\t\n13\texport function missingResource(path: string): AppError {\n14\t  return { code: 'NOT_FOUND', message: `Missing: ${path}` };\n15\t}\n16\t\n17\texport function statusFor(error: AppError): number {\n18\t  switch (error.code) {\n19\t    case 'NOT_FOUND':\n20\t      return 404;\n21\t    default:\n22\t      return 500;\n23\t  }\n24\t}\n25\t"}]},"parent_tool_use_id":null,"session_id":"7469f7f6-d45f-4816-b080-90944f51ab9d","uuid":"44c313f5-41d9-47c2-b0e7-4d2c16b2c950","timestamp":"2026-09-12T21:17:35.896Z","tool_use_result":{"type":"text","file":{"filePath":"src/kernel/errors.ts","content":"/**\n * Error taxonomy and status map.\n *\n * Errors carry a code and a message. The status map keeps the HTTP status\n * that belongs to each code in one place.\n */\n\nexport interface AppError {\n  readonly code: string;\n  readonly message: string;\n}\n\nexport function missingResource(path: string): AppError {\n  return { code: 'NOT_FOUND', message: `Missing: ${path}` };\n}\n\nexport function statusFor(error: AppError): number {\n  switch (error.code) {\n    case 'NOT_FOUND':\n      return 404;\n    default:\n      return 500;\n  }\n}\n","numLines":25,"startLine":1,"totalLines":25}}}
