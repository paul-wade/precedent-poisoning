node_modules/

# Run output. A published run is added explicitly with `git add -f`, so a
# working directory full of local trials never makes the tree dirty — which
# would abort every trial, since a run verifies its tree is clean before each.
runs/

# Installed by the arms, one at a time, and removed between trials.
.claude/
CLAUDE.md

# Notes from whoever is driving the runs. Working material, not results;
# two of these were committed by accident and had to be taken back out.
.cyv-review/
checkyourvibe.json

# Written by validate-fixtures while it typechecks a probe, and removed again.
# Listed so a crash mid-check cannot leave it in a commit.
src/validate-probe.generated.ts
